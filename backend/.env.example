PORT=8080
NODE_ENV=development
JWT_SECRET=dev-cloudfs-access-secret-change
REFRESH_SECRET=dev-cloudfs-refresh-secret-change
URL_SIGNING_SECRET=dev-cloudfs-url-signing-secret-change
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=
STORAGE_DIR=./storage

# Default per-user storage quota in bytes (15 GB if unset)
DEFAULT_QUOTA_BYTES=16106127360

# Supabase (optional — for managed DB + Storage)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=drive

# Redis (background jobs — optional for MVP)
REDIS_URL=

# If S3 used instead of Supabase Storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET=drive-bucket
